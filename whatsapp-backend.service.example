[Unit]
Description=WhatsApp KDE Widget Backend Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust these paths if the repository is not checked out at
# ~/whatsapp-kde-widget (the widget's manage.sh writes an absolute-path
# service automatically when you run `./manage.sh enable-autostart`).
WorkingDirectory=%h/whatsapp-kde-widget/backend
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
StandardOutput=append:%h/whatsapp-kde-widget/backend.log
StandardError=append:%h/whatsapp-kde-widget/backend.log

[Install]
WantedBy=default.target
